{
  "datasets": [
    {
      "name": "9d286a53",
      "displayName": "vw_fact_orders_enriched",
      "config": {
        "version": "1.1",
        "source": "fmcg.gold.vw_fact_orders_enriched",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "top10_products_rev",
      "displayName": "Top 10 Products by Revenue",
      "config": {
        "version": "1.1",
        "source": "SELECT product, SUM(total_amount_inr) AS total_revenue FROM fmcg.gold.vw_fact_orders_enriched GROUP BY product ORDER BY total_revenue DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "product",
            "expr": "source.product",
            "displayName": "Product"
          }
        ],
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(source.total_revenue)",
            "displayName": "Total Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "ab03cdce",
      "displayName": "All Customers: Quantity Sold &amp; Total Amount (INR)",
      "queryLines": [
        "\n",
        "SELECT \n",
        "  `customer` AS customer_name,\n",
        "  SUM(`sold_quantity`) AS quantity_sold,\n",
        "  SUM(`total_amount_inr`) AS total_amount_inr\n",
        "FROM `fmcg`.`gold`.`vw_fact_orders_enriched`\n",
        "WHERE `customer` IS NOT NULL\n",
        "  AND `sold_quantity` IS NOT NULL\n",
        "  AND `total_amount_inr` IS NOT NULL\n",
        "GROUP BY `customer`\n",
        "ORDER BY total_amount_inr DESC\n"
      ]
    },
    {
      "name": "ac4fb603",
      "displayName": "Top 10 Products by Revenue Share",
      "queryLines": [
        "\n",
        "SELECT \n",
        "  `product`,\n",
        "  SUM(`total_amount_inr`) AS total_revenue,\n",
        "  ROUND(SUM(`total_amount_inr`) * 100.0 / SUM(SUM(`total_amount_inr`)) OVER (), 2) AS revenue_share_pct\n",
        "FROM `fmcg`.`gold`.`vw_fact_orders_enriched`\n",
        "WHERE `product` IS NOT NULL\n",
        "  AND `total_amount_inr` IS NOT NULL\n",
        "GROUP BY `product`\n",
        "ORDER BY total_revenue DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "f53f00fe",
      "displayName": "Product Price vs Quantity Sold",
      "queryLines": [
        "\n",
        "SELECT \n",
        "  `product`,\n",
        "  AVG(`price_inr`) AS avg_price_inr,\n",
        "  SUM(`sold_quantity`) AS total_quantity_sold,\n",
        "  SUM(`total_amount_inr`) AS total_revenue,\n",
        "  `division`\n",
        "FROM `fmcg`.`gold`.`vw_fact_orders_enriched`\n",
        "WHERE `product` IS NOT NULL\n",
        "  AND `price_inr` IS NOT NULL\n",
        "  AND `sold_quantity` IS NOT NULL\n",
        "  AND `division` IS NOT NULL\n",
        "GROUP BY `product`, `division`\n",
        "ORDER BY total_revenue DESC\n"
      ]
    }
  ],
