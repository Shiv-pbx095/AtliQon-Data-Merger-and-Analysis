{
  "datasets": [
    {
      "name": "6f4f2c06",
      "displayName": "vw_fact_orders_enriched",
      "config": {
        "version": "1.1",
        "source": "fmcg.gold.vw_fact_orders_enriched",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "top10_customers_revenue",
      "displayName": "Top 10 Customers by Revenue",
      "config": {
        "version": "1.1",
        "source": "SELECT customer, SUM(total_amount_inr) AS revenue FROM fmcg.gold.vw_fact_orders_enriched GROUP BY customer ORDER BY revenue DESC LIMIT 10",
        "dimensions": [
          {
            "name": "customer",
            "expr": "source.customer"
          }
        ],
        "measures": [
          {
            "name": "revenue",
            "expr": "SUM(source.revenue)"
          }
        ]
      }
    },
    {
      "name": "cumulative_revenue_share",
      "displayName": "Cumulative Revenue Share by Customer",
      "config": {
        "version": "1.1",
        "source": "SELECT customer, SUM(total_amount_inr) AS revenue, SUM(total_amount_inr) * 100.0 / SUM(SUM(total_amount_inr)) OVER () AS revenue_share, SUM(SUM(total_amount_inr)) OVER (ORDER BY SUM(total_amount_inr) DESC) * 100.0 / SUM(SUM(total_amount_inr)) OVER () AS cumulative_share, ROW_NUMBER() OVER (ORDER BY SUM(total_amount_inr) DESC) AS rank FROM fmcg.gold.vw_fact_orders_enriched GROUP BY customer ORDER BY revenue DESC",
        "dimensions": [
          {
            "name": "customer",
            "expr": "source.customer"
          },
          {
            "name": "rank",
            "expr": "source.rank"
          }
        ],
        "measures": [
          {
            "name": "revenue",
            "expr": "SUM(source.revenue)"
          },
          {
            "name": "revenue_share",
            "expr": "SUM(source.revenue_share)"
          },
          {
            "name": "cumulative_share",
            "expr": "SUM(source.cumulative_share)"
          }
        ]
      }
    },
    {
      "name": "customers_for_80pct",
      "displayName": "Customers for 80% Revenue",
      "config": {
        "version": "1.1",
        "source": "SELECT MIN(rank) AS customers_needed FROM ( SELECT customer, SUM(total_amount_inr) AS revenue, SUM(SUM(total_amount_inr)) OVER (ORDER BY SUM(total_amount_inr) DESC) * 100.0 / SUM(SUM(total_amount_inr)) OVER () AS cumulative_share, ROW_NUMBER() OVER (ORDER BY SUM(total_amount_inr) DESC) AS rank FROM fmcg.gold.vw_fact_orders_enriched GROUP BY customer ) t WHERE cumulative_share >= 80",
        "measures": [
          {
            "name": "customers_needed",
            "expr": "SUM(source.customers_needed)"
          }
        ]
      }
    },
    {
      "name": "new_customers_per_year",
      "displayName": "New Customers per Year",
      "config": {
        "version": "1.1",
        "source": "SELECT first_purchase_year, COUNT(*) AS new_customers FROM ( SELECT customer, MIN(`year`) AS first_purchase_year FROM fmcg.gold.vw_fact_orders_enriched GROUP BY customer ) t GROUP BY first_purchase_year ORDER BY first_purchase_year",
        "dimensions": [
          {
            "name": "first_purchase_year",
            "expr": "source.first_purchase_year"
          }
        ],
        "measures": [
          {
            "name": "new_customers",
            "expr": "SUM(source.new_customers)"
          }
        ]
      }
    },
    {
      "name": "retention_rate",
      "displayName": "Customer Retention Rate",
      "config": {
        "version": "1.1",
        "source": "SELECT (COUNT(DISTINCT CASE WHEN EXISTS ( SELECT 1 FROM fmcg.gold.vw_fact_orders_enriched b WHERE b.customer = f.customer AND b.year = (SELECT MAX(year) FROM fmcg.gold.vw_fact_orders_enriched) ) THEN f.customer END) * 100.0 / COUNT(DISTINCT f.customer)) AS retention_rate, COUNT(DISTINCT f.customer) AS prev_year_customers, COUNT(DISTINCT CASE WHEN EXISTS ( SELECT 1 FROM fmcg.gold.vw_fact_orders_enriched b WHERE b.customer = f.customer AND b.year = (SELECT MAX(year) FROM fmcg.gold.vw_fact_orders_enriched) ) THEN f.customer END) AS retained_customers FROM fmcg.gold.vw_fact_orders_enriched f WHERE f.year = (SELECT MAX(year) FROM fmcg.gold.vw_fact_orders_enriched WHERE year < (SELECT MAX(year) FROM fmcg.gold.vw_fact_orders_enriched)) AND f.customer IS NOT NULL",
        "measures": [
          {
            "name": "retention_rate",
            "expr": "SUM(source.retention_rate)"
          },
          {
            "name": "prev_year_customers",
            "expr": "SUM(source.prev_year_customers)"
          },
          {
            "name": "retained_customers",
            "expr": "SUM(source.retained_customers)"
          }
        ]
      }
    },
    {
      "name": "customer_count_by_year",
      "displayName": "Customer Count by Year",
      "config": {
        "version": "1.1",
        "source": "SELECT CAST(DATE_TRUNC('year', `date`) AS DATE) AS year_date, COUNT(DISTINCT customer) AS customer_count FROM fmcg.gold.vw_fact_orders_enriched WHERE customer IS NOT NULL GROUP BY CAST(DATE_TRUNC('year', `date`) AS DATE) ORDER BY year_date",
        "dimensions": [
          {
            "name": "year_date",
            "expr": "source.year_date"
          }
        ],
        "measures": [
          {
            "name": "customer_count",
            "expr": "SUM(source.customer_count)"
          }
        ]
      }
    }
  ],
